private theorem checkpoint3_input_exact :
    absorbWords (checkpointState checkpoint2Values) domainBlock3 =
      checkpoint3InputState := by
  apply stateView_injective
  native_decide

private theorem checkpoint3_initial_valid :
    PhaseReceipt.Valid checkpoint3InitialStates halfFullRounds
      (applyMatrixValues Poseidon2Matrices.externalMatrix
        (valuesOf checkpoint3InputValues))
      (fun round => fullRoundValues (selected.initial round)) := by
  constructor
  · native_decide
  · funext lane
    fin_cases lane <;> native_decide
  · intro round roundLt
    change round < 4 at roundLt
    interval_cases round <;> native_decide

private theorem checkpoint3_partial_valid :
    PhaseReceipt.Valid checkpoint3PartialStates partialRounds
      (receiptState checkpoint3InitialStates halfFullRounds)
      (fun round => partialRoundValues (selected.internal round)) := by
  constructor
  · native_decide
  · funext lane
    fin_cases lane <;> native_decide
  · intro round roundLt
    change round < 22 at roundLt
    interval_cases round <;> native_decide

private theorem checkpoint3_terminal_valid :
    PhaseReceipt.Valid checkpoint3TerminalStates halfFullRounds
      (receiptState checkpoint3PartialStates partialRounds)
      (fun round => fullRoundValues (selected.terminal round)) := by
  constructor
  · native_decide
  · funext lane
    fin_cases lane <;> native_decide
  · intro round roundLt
    change round < 4 at roundLt
    interval_cases round <;> native_decide

private theorem checkpoint3_reference_exact :
    referencePermutation selected (valuesOf checkpoint3InputValues) =
      valuesOf checkpoint3Values := by
  have initialExact := checkpoint3_initial_valid.finalExact
  rw [runInitial_eq_refInitial] at initialExact
  have partialExact := checkpoint3_partial_valid.finalExact
  rw [initialExact, runPartial_eq_refPartial] at partialExact
  have terminalExact := checkpoint3_terminal_valid.finalExact
  rw [partialExact, runTerminal_eq_refTerminal] at terminalExact
  rw [referencePermutation]
  exact terminalExact.symm.trans (by native_decide)

theorem checkpoint3_exact :
    permute (absorbWords (checkpointState checkpoint2Values) domainBlock3) =
      checkpointState checkpoint3Values := by
  rw [checkpoint3_input_exact]
  apply state_ext
  · intro lane
    change
      Poseidon2PermutationSound.permute
          (laneNat checkpoint3InputState) lane.val % goldilocksP = _
    have inputFunctionsEqual :
        laneNat checkpoint3InputState =
          stateLaneValues checkpoint3InputState := by
      funext inputLane
      rfl
    rw [inputFunctionsEqual,
      Nat.mod_eq_of_lt
        (Poseidon2PermutationSound.permute_lt
          (stateLaneValues_canonical checkpoint3InputState) lane.val),
      Poseidon2ExtractedReference.permute_eq_reference
        (stateLaneValues_canonical checkpoint3InputState) lane]
    have inputExact :
        (fun inputLane : Fin Poseidon2Core.width =>
          stateLaneValues checkpoint3InputState inputLane.val) =
          valuesOf checkpoint3InputValues := by
      funext inputLane
      fin_cases inputLane <;> native_decide
    rw [inputExact, checkpoint3_reference_exact]
    simp [valuesOf, checkpointState, stateFromValues, fieldValue]
    fin_cases lane <;> native_decide
  · rfl

