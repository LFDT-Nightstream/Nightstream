import Nightstream.Implementation.R1CS.Canonical.KSplitNcFeInitial
import Nightstream.Implementation.R1CS.Canonical.KSplitNcFeTerminal
import Nightstream.Implementation.R1CS.Canonical.KSplitNcNcEndpoint
import Nightstream.Implementation.R1CS.Canonical.KSplitNcOperational

/-!
Contract: compose the four verifier-owned Split-NC endpoint computations.

The transcript owns every challenge column and every final SumCheck point.
`AuthorityColumns` owns only direct reads of the public PiCCS input and raw
output message.  Its decoding relation is intended to be constructed by the
selected call-frame codec; it contains no verifier result, endpoint equation,
or acceptance proposition.

Satisfaction of `rows` constructs `KSplitNcOperational.EndpointAgrees`.
Thus the operational verifier no longer accepts its four endpoint equations
as caller data.
-/

set_option autoImplicit false
set_option maxRecDepth 100000

namespace Nightstream.Implementation.R1CS.Canonical.KSplitNcEndpoints

open Nightstream.Implementation.R1CS
open Nightstream.Implementation.R1CS.Canonical.KMul
open Nightstream.Implementation.Lowering.FPrimeFixedOne.Encoding.KFixedPhaseSemanticOccurrence
open Nightstream.SuperNeo
open Nightstream.SuperNeo.Concrete
open Nightstream.SuperNeo.Folding.PiCCS.OutputClaims
open Nightstream.SuperNeo.Folding.PiCCS.PaperJoint
open Nightstream.SuperNeo.Folding.PiCCS.SplitNc
open Nightstream.SuperNeo.Folding.PiCCS.SplitNc.Verifier
open Nightstream.SuperNeo.Folding.PiCCS.SplitNc.Verifier.Protocol.TranscriptAuthority.BlockLane

private abbrev KColumns :=
  Nightstream.Implementation.R1CS.ProjectionProgram.KColumns

/-- Direct physical views of the semantic values not generated by the
Fiat--Shamir transcript. -/
structure AuthorityColumns (shape : SemanticShape) where
  priorPoint : Fin shape.rowVariables → Carried
  claimedYRing :
    Fin shape.runningCount → Fin shape.matrixCount →
      Fin ringDegree → Carried
  outputYRing :
    Fin shape.sourceCount → Fin shape.matrixCount →
      Fin ringDegree → Carried
  outputYZcol :
    Fin shape.sourceCount → Fin ringDegree → Carried

/-- All endpoint-row inputs around one exact transcript occurrence. -/
structure Input
    {shape : SemanticShape}
    (polynomialInput : PublicInput shape) (domains : Domains) where
  transcript : KSplitNcTranscript.Input polynomialInput domains
  authority : AuthorityColumns shape
  frameBase : Nat

/-- Select one carried extension value from an exact-width transcript list. -/
def carriedAt
    {count : Nat}
    (columns : List KColumns) (length : columns.length = count)
    (index : Fin count) : Carried :=
  carried
    (columns.get
      ⟨index.val, by
        rw [length]
        exact index.isLt⟩)

theorem decoded_carriedAt
    {count : Nat}
    (columns : List KColumns) (length : columns.length = count)
    (assignment : Nat → Nat) (index : Fin count) :
    KPointEquality.decoded assignment
        (carriedAt columns length index) =
      (KSplitNcTranscriptSemantics.decodedColumnList assignment columns).get
        ⟨index.val, by
          rw [KSplitNcTranscriptSemantics.decodedColumnList_length, length]
          exact index.isLt⟩ := by
  unfold carriedAt KPointEquality.decoded
  rw [decodeCarried_carried]
  simp [KSplitNcTranscriptSemantics.decodedColumnList,
    KSplitNcTranscriptSemantics.decodedColumns]

@[simp] theorem feRowChallenges_length
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : KSplitNcTranscript.Input polynomialInput domains) :
    (KSplitNcTranscript.feRowReplay input).challenges.length =
      shape.rowVariables := by
  unfold KSplitNcTranscript.feRowReplay
  rw [KSplitNcTranscript.replayRounds_challenges_length]
  simp

@[simp] theorem feLaneChallenges_length
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : KSplitNcTranscript.Input polynomialInput domains) :
    (KSplitNcTranscript.feLaneReplay input).challenges.length =
      domains.laneVariables := by
  unfold KSplitNcTranscript.feLaneReplay
  rw [KSplitNcTranscript.replayRounds_challenges_length]
  simp

@[simp] theorem ncBlockChallenges_length
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : KSplitNcTranscript.Input polynomialInput domains) :
    (KSplitNcTranscript.ncBlockReplay input).challenges.length =
      domains.blockVariables := by
  unfold KSplitNcTranscript.ncBlockReplay
  rw [KSplitNcTranscript.replayRounds_challenges_length]
  simp [Domains.nc]

@[simp] theorem ncLaneChallenges_length
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : KSplitNcTranscript.Input polynomialInput domains) :
    (KSplitNcTranscript.ncLaneReplay input).challenges.length =
      domains.laneVariables := by
  unfold KSplitNcTranscript.ncLaneReplay
  rw [KSplitNcTranscript.replayRounds_challenges_length]
  simp [Domains.nc]

def coreAlpha
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    Fin domains.laneVariables → Carried :=
  carriedAt (KSplitNcTranscript.coreReplay input.transcript).alpha
    (KSplitNcTranscript.Core.alpha_length
      (KSplitNcTranscript.coreReplay input.transcript))

def coreBetaA
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    Fin domains.laneVariables → Carried :=
  carriedAt (KSplitNcTranscript.coreReplay input.transcript).betaA
    (KSplitNcTranscript.Core.betaA_length
      (KSplitNcTranscript.coreReplay input.transcript))

def coreBetaR
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    Fin shape.rowVariables → Carried :=
  carriedAt (KSplitNcTranscript.coreReplay input.transcript).betaR
    (KSplitNcTranscript.Core.betaR_length
      (KSplitNcTranscript.coreReplay input.transcript))

def coreBetaBlock
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    Fin domains.blockVariables → Carried :=
  carriedAt (KSplitNcTranscript.coreReplay input.transcript).betaBlock
