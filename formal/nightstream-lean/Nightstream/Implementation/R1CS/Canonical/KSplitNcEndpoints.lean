    Fin domains.blockVariables → Carried :=
  carriedAt (KSplitNcTranscript.ncBlockReplay input.transcript).challenges
    (ncBlockChallenges_length input.transcript)

def ncLanePoint
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    Fin domains.laneVariables → Carried :=
  carriedAt (KSplitNcTranscript.ncLaneReplay input.transcript).challenges
    (ncLaneChallenges_length input.transcript)

def feInitialInput
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    KSplitNcFeInitial.Input shape domains.fe where
  gamma := carried (KSplitNcTranscript.coreReplay input.transcript).gamma
  alpha := coreAlpha input
  claimedYRing := input.authority.claimedYRing
  initial := carried input.transcript.fe.initial
  frameBase := input.frameBase

def feTerminalBase
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) : Nat :=
  input.frameBase +
    KSplitNcFeInitial.allocationWidth (feInitialInput input)

def feTerminalInput
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    KSplitNcFeTerminal.Input polynomialInput domains.fe where
  gamma := carried (KSplitNcTranscript.coreReplay input.transcript).gamma
  alpha := coreAlpha input
  betaA := coreBetaA input
  betaR := coreBetaR input
  pointLane := feLanePoint input
  pointRow := feRowPoint input
  priorPoint := input.authority.priorPoint
  messageYRing := input.authority.outputYRing
  terminal := carried input.transcript.fe.terminal
  frameBase := feTerminalBase input

def ncBase
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) : Nat :=
  feTerminalBase input +
    KSplitNcFeTerminal.allocationWidth (feTerminalInput input)

def ncInput
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    KSplitNcNcEndpoint.Input shape domains.nc where
  gamma := carried (KSplitNcTranscript.coreReplay input.transcript).gamma
  betaBlock := coreBetaBlock input
  betaA := coreBetaA input
  pointBlock := ncBlockPoint input
  pointLane := ncLanePoint input
  messageYZcol := input.authority.outputYZcol
  initial := carried input.transcript.nc.initial
  terminal := carried input.transcript.nc.terminal
  frameBase := ncBase input

def rowGroups
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) : List (List Row) :=
  [
    KSplitNcFeInitial.rows (feInitialInput input),
    KSplitNcFeTerminal.rows (feTerminalInput input),
    KSplitNcNcEndpoint.rows (ncInput input)
  ]

def rows
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) : List Row :=
  (rowGroups input).flatten

theorem rows_length
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    (rows input).length =
      (KSplitNcFeInitial.rows (feInitialInput input)).length +
        (KSplitNcFeTerminal.rows (feTerminalInput input)).length +
        (KSplitNcNcEndpoint.rows (ncInput input)).length := by
  simp [rows, rowGroups]
  omega

/-- Exact compact endpoint allocation.  The three endpoint subprograms are
placed by their allocated widths, never by their larger row counts. -/
def allocationWidth
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) : Nat :=
  KSplitNcFeInitial.allocationWidth (feInitialInput input) +
    KSplitNcFeTerminal.allocationWidth (feTerminalInput input) +
      KSplitNcNcEndpoint.allocationWidth (ncInput input)

/-- Ordered endpoint auxiliary interval. -/
def columns
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) : List Nat :=
  (List.range (allocationWidth input)).map
    (fun offset => input.frameBase + offset)

theorem columns_length
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    (columns input).length = allocationWidth input := by
  simp [columns]

theorem columns_nodup
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    (columns input).Nodup := by
  unfold columns
  exact LinCombNormal.nodup_map _ _ (fun left right equal => by omega)
    List.nodup_range

theorem rows_length_eq_allocationWidth_add_eight
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) :
    (rows input).length = allocationWidth input + 8 := by
  rw [rows_length,
    KSplitNcFeInitial.rows_length_eq_allocationWidth_add_two,
    KSplitNcFeTerminal.rows_length_eq_allocationWidth_add_two,
    KSplitNcNcEndpoint.rows_length_eq_allocationWidth_add_four]
  unfold allocationWidth
  omega

/-- Exact semantic binding supplied later by the selected whole-frame codec.
No field is an endpoint equation or verifier result. -/
structure DecodedAuthority
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains)
    (assignment : Nat → Nat)
    (message : OutputMessage shape) : Prop where
  priorPoint :
    ∀ coordinate,
      KPointEquality.decoded assignment
          (input.authority.priorPoint coordinate) =
        polynomialInput.priorPoint.coordinates.get
          ⟨coordinate.val, by
            rw [polynomialInput.priorPoint.dimension]
            exact coordinate.isLt⟩
  claimedYRing :
    ∀ running matrix lane,
      KPointEquality.decoded assignment
          (input.authority.claimedYRing running matrix lane) =
        polynomialInput.claimedYRing running matrix lane
  outputYRing :
    ∀ source matrix lane,
      KPointEquality.decoded assignment
          (input.authority.outputYRing source matrix lane) =
        message.yRing source matrix lane
  outputYZcol :
    ∀ source lane,
      KPointEquality.decoded assignment
          (input.authority.outputYZcol source lane) =
        message.yZcol source lane

theorem satisfies_group
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains)
    (assignment : Nat → Nat)
    (satisfied : Satisfies (rows input) assignment)
    (group : List Row) (member : group ∈ rowGroups input) :
    Satisfies group assignment := by
  intro row rowMember
  exact satisfied row (List.mem_flatten.2 ⟨group, member, rowMember⟩)

def decodedPointOf
    {count : Nat}
    (values : Fin count → Carried) (assignment : Nat → Nat) :
    CubePoint K count where
  coordinates := List.ofFn fun index =>
    KPointEquality.decoded assignment (values index)
  dimension := by simp

private theorem cubePoint_eq_of_coordinates_eq
    {count : Nat} (left right : CubePoint K count)
    (coordinates : left.coordinates = right.coordinates) :
    left = right := by
  cases left
  cases right
  simp_all

theorem decoded_carried
    (assignment : Nat → Nat) (columns : KColumns) :
    KPointEquality.decoded assignment (carried columns) =
      KSplitNcTranscriptSemantics.decodedColumns assignment columns := by
  unfold KPointEquality.decoded
  rw [decodeCarried_carried]
  rfl

theorem decodedPointOf_carriedAt_eq
    {count : Nat}
    (columns : List KColumns) (length : columns.length = count)
    (assignment : Nat → Nat) :
    decodedPointOf (carriedAt columns length) assignment =
      {
        coordinates :=
          KSplitNcTranscriptSemantics.decodedColumnList assignment columns
        dimension := by
          rw [
            KSplitNcTranscriptSemantics.decodedColumnList_length, length]
      } := by
  apply cubePoint_eq_of_coordinates_eq
  unfold decodedPointOf
  apply List.ext_getElem
  · rw [List.length_ofFn,
      KSplitNcTranscriptSemantics.decodedColumnList_length]
    exact length.symm
  · intro index leftBound rightBound
    have indexLt : index < count := by simpa using leftBound
    simp only [List.getElem_ofFn]
    exact decoded_carriedAt columns length assignment ⟨index, indexLt⟩

theorem feInitial_decoder_eq
    (assignment : Nat → Nat) (value : Carried) :
    KSplitNcFeInitial.decoded assignment value =
      KPointEquality.decoded assignment value := by
  unfold KSplitNcFeInitial.decoded
  apply KConcreteBridge.ofConcrete_injective
  rw [KBooleanMleSemantics.ofConcrete_decodeCarried,
    KPointEquality.ofConcrete_decoded]

theorem feInitialAlpha_eq_core
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains)
    (assignment : Nat → Nat) :
    KSplitNcFeInitial.decodedAlpha (feInitialInput input) assignment =
      decodedPointOf (coreAlpha input) assignment := by
  apply cubePoint_eq_of_coordinates_eq
  simp only [KSplitNcFeInitial.decodedAlpha,
    KSplitNcFeInitial.alphaCoordinates,
    KBooleanMleSemantics.decodePoint, decodedPointOf,
    List.map_ofFn, Function.comp_apply]
  apply congrArg List.ofFn
  funext coordinate
  exact feInitial_decoder_eq assignment (coreAlpha input coordinate)

theorem decodedPointOf_carriedAt_eq_of_coordinates
    {count : Nat}
    (columns : List KColumns) (length : columns.length = count)
    (assignment : Nat → Nat) (point : CubePoint K count)
    (coordinates :
      KSplitNcTranscriptSemantics.decodedColumnList assignment columns =
        point.coordinates) :
    decodedPointOf (carriedAt columns length) assignment = point := by
  apply cubePoint_eq_of_coordinates_eq
  rw [decodedPointOf_carriedAt_eq]
  exact coordinates

theorem coreAlpha_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (constants : Poseidon2Schedule.Constants)
    (assignment : Nat → Nat)
    (input : Input polynomialInput domains)
    (pre :
      KSplitNcTranscriptSemantics.PreAgrees assignment
        (KSplitNcTranscript.replay input.transcript)
        (KSplitNcTranscriptPhases.semanticPre
          constants assignment input.transcript)) :
    decodedPointOf (coreAlpha input) assignment =
      (KSplitNcTranscriptPhases.semanticPre
        constants assignment input.transcript).challenges.alpha := by
  apply decodedPointOf_carriedAt_eq_of_coordinates
  exact pre.alpha

theorem coreBetaA_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
