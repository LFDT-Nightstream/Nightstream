theorem definitions_canonical :
∀ definition ∈ definitions instructions, definition.Canonical := by native_decide
theorem definitions_wellFormed :
WellFormed programInputColumns (definitions instructions) := by native_decide
theorem checks_reference :
ChecksReference
(knownAfter programInputColumns (definitions instructions)) instructions := by native_decide
theorem trace_definitions_are_exact_program_definitions :
∀ definition ∈ projectionTrace.definitions,
definition ∈ definitions instructions := by native_decide
theorem trace_checks_are_exact_program_checks :
projectionTrace.checks = checks instructions := by native_decide
theorem honest_satisfies : Satisfies rows (assignmentOf honestWitness) := by native_decide
theorem badRoot_satisfies : Satisfies rows (assignmentOf badRootWitness) := by native_decide

