def shardOffset : Nat → Nat
  | 0 => 0
  | index + 1 => 110 + 128 * index

def shardLength : Nat → Nat
  | 0 => 110
  | 51 => 85
  | _ => 128

def definitionShardLength : Nat → Nat
  | 0 => 110
  | 51 => 83
  | _ => 128

def shardStart (index : Nat) : Nat :=
  terminalSourceRowStart + shardOffset index

/-- Split at every requested prefix length and retain the complete remainder.
The terminal split uses 51 prefixes, hence 52 shards. -/
def splitRemainder {Alpha : Type} : List Nat → List Alpha → List (List Alpha)
  | [], values => [values]
  | length :: lengths, values =>
      values.take length :: splitRemainder lengths (values.drop length)

def terminalPrefixLengths : List Nat :=
  110 :: List.replicate 50 128

def expectedRowShards : List (List Row) :=
  splitRemainder terminalPrefixLengths rows

def expectedDefinitionShards : List (List Definition) :=
  splitRemainder terminalPrefixLengths definitions

def expectedRowShard (index : Nat) : List Row :=
  expectedRowShards.getD index []

def expectedDefinitionShard (index : Nat) : List Definition :=
  expectedDefinitionShards.getD index []

def rawRows (rows : List RawSourceRow) : List Row :=
  rows.map rawRow

private def rowsPermutationEquivalentListDecidable :
    (source reconstructed : List Row) →
      Decidable (RowsPermutationEquivalentList source reconstructed)
  | [], [] => isTrue True.intro
  | [], _ :: _ => isFalse id
  | _ :: _, [] => isFalse id
  | source :: sources, reconstructed :: reconstructions =>
      match inferInstanceAs
          (Decidable (RowsPermutationEquivalent source reconstructed)),
        rowsPermutationEquivalentListDecidable sources reconstructions with
      | isTrue head, isTrue tail => isTrue ⟨head, tail⟩
      | isFalse head, isTrue _ => isFalse fun equivalent => head equivalent.1
      | isTrue _, isFalse tail => isFalse fun equivalent => tail equivalent.2
      | isFalse head, isFalse _ => isFalse fun equivalent => head equivalent.1

local instance (source reconstructed : List Row) :
    Decidable (RowsPermutationEquivalentList source reconstructed) :=
  rowsPermutationEquivalentListDecidable source reconstructed

local instance (columns : Nat) (term : RawTerm) :
    Decidable (RawTermValid columns term) := by
  unfold RawTermValid
  infer_instance

local instance (row : RawSourceRow) : Decidable (RawSourceRowValid row) := by
  unfold RawSourceRowValid RawTermValid
  infer_instance

/-- One bounded source shard checks exact length/order, fail-closed sparse-row
shape, production dimensions, and the load-bearing sparse A/B/C relation. -/
def ShardValid (index : Nat) : Prop :=
  let source := sourceShard index
  source.length = shardLength index ∧
  source.map RawSourceRow.sourceRow =
    List.range' (shardStart index) (shardLength index) ∧
  (∀ row ∈ source,
    RawSourceRowValid row ∧
      row.rows = rawBoundary.sourceRows ∧
      row.columns = rawBoundary.sourceColumns) ∧
  RowsPermutationEquivalentList (rawRows source) (expectedRowShard index)

local instance (index : Nat) : Decidable (ShardValid index) := by
  unfold ShardValid
  infer_instance

def DefinitionsCanonical (values : List Definition) : Prop :=
  ∀ definition ∈ values, definition.Canonical

local instance (values : List Definition) :
    Decidable (DefinitionsCanonical values) := by
  unfold DefinitionsCanonical
  infer_instance

/-- Canonicality is certified separately so no computation combines a
128-row sparse relation certificate with 128 definition records. -/
def DefinitionShardCanonical (index : Nat) : Prop :=
  (expectedDefinitionShard index).length = definitionShardLength index ∧
    DefinitionsCanonical (expectedDefinitionShard index)

local instance (index : Nat) : Decidable (DefinitionShardCanonical index) := by
  unfold DefinitionShardCanonical
  infer_instance

