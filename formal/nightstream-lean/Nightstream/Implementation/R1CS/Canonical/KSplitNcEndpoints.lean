theorem coreGamma_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (constants : Poseidon2Schedule.Constants)
    (assignment : Nat → Nat)
    (input : Input polynomialInput domains)
    (pre :
      KSplitNcTranscriptSemantics.PreAgrees assignment
        (KSplitNcTranscript.replay input.transcript)
        (KSplitNcTranscriptPhases.semanticPre
          constants assignment input.transcript)) :
    KPointEquality.decoded assignment
        (carried (KSplitNcTranscript.coreReplay input.transcript).gamma) =
      (KSplitNcTranscriptPhases.semanticPre
        constants assignment input.transcript).challenges.gamma := by
  rw [decoded_carried]
  exact pre.gamma

theorem decodedLeft_eq_decodedPointOf
    {count : Nat}
    (input : KPointEquality.Input count) (assignment : Nat → Nat) :
    KPointEquality.decodedLeft input assignment =
      decodedPointOf input.left assignment := by
  apply cubePoint_eq_of_coordinates_eq
  simp only [KPointEquality.decodedLeft, KPointEquality.indices,
    decodedPointOf, List.map_ofFn]
  apply congrArg List.ofFn
  funext coordinate
  rfl

theorem decodedRight_eq_decodedPointOf
    {count : Nat}
    (input : KPointEquality.Input count) (assignment : Nat → Nat) :
    KPointEquality.decodedRight input assignment =
      decodedPointOf input.right assignment := by
  apply cubePoint_eq_of_coordinates_eq
  simp only [KPointEquality.decodedRight, KPointEquality.indices,
    decodedPointOf, List.map_ofFn]
  apply congrArg List.ofFn
  funext coordinate
  rfl

