private theorem checkpoint4_input_exact :
    absorbWords (checkpointState checkpoint3Values) domainBlock4 =
      checkpoint4InputState := by
  apply stateView_injective
  native_decide

private theorem checkpoint4_initial_valid :
    PhaseReceipt.Valid checkpoint4InitialStates halfFullRounds
      (applyMatrixValues Poseidon2Matrices.externalMatrix
        (valuesOf checkpoint4InputValues))
      (fun round => fullRoundValues (selected.initial round)) := by
  constructor
  · native_decide
  · funext lane
    fin_cases lane <;> native_decide
  · intro round roundLt
    change round < 4 at roundLt
    interval_cases round <;> native_decide

private theorem checkpoint4_partial_valid :
    PhaseReceipt.Valid checkpoint4PartialStates partialRounds
      (receiptState checkpoint4InitialStates halfFullRounds)
      (fun round => partialRoundValues (selected.internal round)) := by
  constructor
  · native_decide
  · funext lane
    fin_cases lane <;> native_decide
  · intro round roundLt
    change round < 22 at roundLt
    interval_cases round <;> native_decide

private theorem checkpoint4_terminal_valid :
    PhaseReceipt.Valid checkpoint4TerminalStates halfFullRounds
      (receiptState checkpoint4PartialStates partialRounds)
      (fun round => fullRoundValues (selected.terminal round)) := by
  constructor
  · native_decide
  · funext lane
    fin_cases lane <;> native_decide
  · intro round roundLt
    change round < 4 at roundLt
    interval_cases round <;> native_decide

private theorem checkpoint4_reference_exact :
    referencePermutation selected (valuesOf checkpoint4InputValues) =
      valuesOf checkpoint4Values := by
  have initialExact := checkpoint4_initial_valid.finalExact
  rw [runInitial_eq_refInitial] at initialExact
  have partialExact := checkpoint4_partial_valid.finalExact
  rw [initialExact, runPartial_eq_refPartial] at partialExact
  have terminalExact := checkpoint4_terminal_valid.finalExact
  rw [partialExact, runTerminal_eq_refTerminal] at terminalExact
  rw [referencePermutation]
  exact terminalExact.symm.trans (by native_decide)

theorem checkpoint4_exact :
    permute (absorbWords (checkpointState checkpoint3Values) domainBlock4) =
      checkpointState checkpoint4Values := by
  rw [checkpoint4_input_exact]
  apply state_ext
  · intro lane
    change
      Poseidon2PermutationSound.permute
          (laneNat checkpoint4InputState) lane.val % goldilocksP = _
    have inputFunctionsEqual :
        laneNat checkpoint4InputState =
          stateLaneValues checkpoint4InputState := by
      funext inputLane
      rfl
    rw [inputFunctionsEqual,
      Nat.mod_eq_of_lt
        (Poseidon2PermutationSound.permute_lt
          (stateLaneValues_canonical checkpoint4InputState) lane.val),
      Poseidon2ExtractedReference.permute_eq_reference
        (stateLaneValues_canonical checkpoint4InputState) lane]
    have inputExact :
        (fun inputLane : Fin Poseidon2Core.width =>
          stateLaneValues checkpoint4InputState inputLane.val) =
          valuesOf checkpoint4InputValues := by
      funext inputLane
      fin_cases inputLane <;> native_decide
    rw [inputExact, checkpoint4_reference_exact]
    simp [valuesOf, checkpointState, stateFromValues, fieldValue]
    fin_cases lane <;> native_decide
  · rfl

