def mappedRows (instructions : List Instruction) (columnMap : List Nat) : List Row :=
(CheckedProgram.rows instructions).map (Relabel.row columnMap)

def expectedRows (shared identity : List Instruction) (sharedMap : List Nat)
(identityMaps : List (List Nat)) : List (List Row) :=
identityMaps.map fun identityMap =>
mappedRows shared sharedMap ++ mappedRows identity identityMap

end Nightstream.Implementation.R1CS.FPrimeFullHistoryProjection
