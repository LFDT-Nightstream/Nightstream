private theorem feCoins_eq_of_fields
    {shape : SemanticShape} {domain : FlatNcDomain}
    (left right : Polynomial.Fe.Coins shape domain)
    (alpha : left.alpha = right.alpha)
    (betaA : left.betaA = right.betaA)
    (betaR : left.betaR = right.betaR)
    (gamma : left.gamma = right.gamma) :
    left = right := by
  cases left
  cases right
  simp_all

private theorem ncCoins_eq_of_fields
    {domain : BlockNcDomain}
    (left right : Polynomial.Nc.BlockLane.Mixing.Coins domain)
    (betaBlock : left.betaBlock = right.betaBlock)
    (betaA : left.betaA = right.betaA)
    (gamma : left.gamma = right.gamma) :
    left = right := by
  cases left
  cases right
  simp_all

theorem authorityPriorPoint_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    {message : OutputMessage shape}
    (input : Input polynomialInput domains) (assignment : Nat → Nat)
    (authority : DecodedAuthority input assignment message) :
    decodedPointOf input.authority.priorPoint assignment =
      polynomialInput.priorPoint := by
  apply cubePoint_eq_of_coordinates_eq
  unfold decodedPointOf
  apply List.ext_getElem
  · rw [List.length_ofFn, polynomialInput.priorPoint.dimension]
  · intro index leftBound rightBound
    simp only [List.getElem_ofFn]
    have indexLt : index < shape.rowVariables := by
      simpa using leftBound
    exact authority.priorPoint ⟨index, indexLt⟩

theorem feTerminal_publicInput_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    {message : OutputMessage shape}
    (input : Input polynomialInput domains) (assignment : Nat → Nat)
    (authority : DecodedAuthority input assignment message) :
    KSplitNcFeTerminal.decodedPublicInput
        (feTerminalInput input) assignment =
      polynomialInput := by
  apply PublicInput.ext
  · rfl
  · rw [KSplitNcFeTerminal.decodedPublicInput,
      decodedRight_eq_decodedPointOf]
    exact authorityPriorPoint_eq input assignment authority
  · rfl

theorem feTerminal_coins_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (constants : Poseidon2Schedule.Constants)
    (assignment : Nat → Nat)
    (input : Input polynomialInput domains)
    (pre :
      KSplitNcTranscriptSemantics.PreAgrees assignment
        (KSplitNcTranscript.replay input.transcript)
        (KSplitNcTranscriptPhases.semanticPre
          constants assignment input.transcript)) :
    KSplitNcFeTerminal.decodedCoins
        (feTerminalInput input) assignment =
      (KSplitNcTranscriptPhases.semanticPre
        constants assignment input.transcript).challenges.feCoins := by
  apply feCoins_eq_of_fields
  · rw [KSplitNcFeTerminal.decodedCoins,
      decodedRight_eq_decodedPointOf]
    exact coreAlpha_eq constants assignment input pre
  · change
      KPointEquality.decodedRight
          (KSplitNcFeTerminal.freshLaneEqualityInput
            (feTerminalInput input)) assignment = _
    rw [decodedRight_eq_decodedPointOf]
    exact coreBetaA_eq constants assignment input pre
  · change
      KPointEquality.decodedRight
          (KSplitNcFeTerminal.freshRowEqualityInput
            (feTerminalInput input)) assignment = _
    rw [decodedRight_eq_decodedPointOf]
    exact coreBetaR_eq constants assignment input pre
  · exact coreGamma_eq constants assignment input pre

theorem feTerminal_point_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) (assignment : Nat → Nat) :
    KSplitNcFeTerminal.decodedPoint
        (feTerminalInput input) assignment =
      KSplitNcTranscriptPhases.decodedFePoint
        assignment input.transcript := by
  apply Polynomial.Fe.Point.ext
  · rw [KSplitNcFeTerminal.decodedPoint,
      decodedLeft_eq_decodedPointOf]
    exact feRowPoint_eq_decoded input assignment
  · change
      KPointEquality.decodedLeft
          (KSplitNcFeTerminal.freshLaneEqualityInput
            (feTerminalInput input)) assignment = _
    rw [decodedLeft_eq_decodedPointOf]
    exact feLanePoint_eq_decoded input assignment

theorem ncCoins_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (constants : Poseidon2Schedule.Constants)
    (assignment : Nat → Nat)
    (input : Input polynomialInput domains)
    (pre :
      KSplitNcTranscriptSemantics.PreAgrees assignment
        (KSplitNcTranscript.replay input.transcript)
        (KSplitNcTranscriptPhases.semanticPre
          constants assignment input.transcript)) :
    KSplitNcNcEndpoint.decodedCoins (ncInput input) assignment =
      (KSplitNcTranscriptPhases.semanticPre
        constants assignment input.transcript).challenges.ncCoins := by
  apply ncCoins_eq_of_fields
  · rw [KSplitNcNcEndpoint.decodedCoins,
      decodedRight_eq_decodedPointOf]
    exact coreBetaBlock_eq constants assignment input pre
  · change
      KPointEquality.decodedRight
          (KSplitNcNcEndpoint.laneEqualityInput (ncInput input))
          assignment = _
    rw [decodedRight_eq_decodedPointOf]
    exact coreBetaA_eq constants assignment input pre
  · exact coreGamma_eq constants assignment input pre

theorem ncPoint_eq
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (input : Input polynomialInput domains) (assignment : Nat → Nat) :
    KSplitNcNcEndpoint.decodedPoint (ncInput input) assignment =
      KSplitNcTranscriptPhases.decodedNcPoint
        assignment input.transcript := by
  apply Polynomial.Nc.BlockLane.Point.ext
  · rw [KSplitNcNcEndpoint.decodedPoint,
      decodedLeft_eq_decodedPointOf]
    exact ncBlockPoint_eq_decoded input assignment
  · change
      KPointEquality.decodedLeft
          (KSplitNcNcEndpoint.laneEqualityInput (ncInput input))
          assignment = _
    rw [decodedLeft_eq_decodedPointOf]
    exact ncLanePoint_eq_decoded input assignment

theorem ncLaneTable_eq_of_yZcol
    {shape : SemanticShape} {domain : BlockNcDomain}
    (left right : Claims shape)
    (yZcol : ∀ source lane, left.yZcol source lane = right.yZcol source lane)
    (source : Fin shape.sourceCount) :
    Polynomial.Nc.BlockLane.Terminal.laneTable
        (domain := domain) left source =
      Polynomial.Nc.BlockLane.Terminal.laneTable right source := by
  unfold Polynomial.Nc.BlockLane.Terminal.laneTable
  apply congrArg BooleanTable.tabulate
  funext vertex
  unfold Polynomial.Nc.BlockLane.Terminal.paddedYZcol
  split
  · exact yZcol source _
  · rfl

theorem ncTerminal_eq_of_yZcol
    {shape : SemanticShape} {domain : BlockNcDomain}
    (left right : Claims shape)
    (yZcol : ∀ source lane, left.yZcol source lane = right.yZcol source lane)
    (coins : Polynomial.Nc.BlockLane.Mixing.Coins domain)
    (point : Polynomial.Nc.BlockLane.Point domain) :
    Polynomial.Nc.BlockLane.Terminal.terminalFromMessage left coins point =
      Polynomial.Nc.BlockLane.Terminal.terminalFromMessage
        right coins point := by
  unfold Polynomial.Nc.BlockLane.Terminal.terminalFromMessage
  apply congrArg
  unfold Polynomial.Nc.BlockLane.Terminal.mixedRangeAt
  apply FiniteSumAlgebra.sumMap_congr
  intro source member
  apply congrArg
  unfold Polynomial.Nc.BlockLane.Terminal.rangeAt
  have laneTable :=
    ncLaneTable_eq_of_yZcol
      (domain := domain) left right yZcol source
  unfold Polynomial.Nc.BlockLane.Terminal.valueAt
  rw [laneTable]

/-- Every verifier-owned endpoint equation is derived from physical rows,
the exact transcript replay, and direct decoding of the selected public
inputs.  No endpoint equation or acceptance proposition is a premise. -/
theorem endpointAgrees_of_rows
    {shape : SemanticShape}
    {polynomialInput : PublicInput shape}
    {domains : Domains}
    (profile : Polynomial.Fe.SupportedProfile shape domains.fe)
    (constants : Poseidon2Schedule.Constants)
    (assignment : Nat → Nat)
    (constantWire : assignment 0 = 1)
    (input : Input polynomialInput domains)
    (message : OutputMessage shape)
    (transcriptValid :
      SymbolicDuplexSemantics.Valid
        input.transcript.transcriptBase constants assignment
        (KSplitNcTranscript.outputBuilder input.transcript))
    (authority : DecodedAuthority input assignment message)
    (satisfied : Satisfies (rows input) assignment) :
    KSplitNcOperational.EndpointAgrees
      profile constants assignment input.transcript message := by
  have feInitialSatisfied :
      Satisfies
        (KSplitNcFeInitial.rows (feInitialInput input)) assignment :=
    satisfies_group input assignment satisfied _ (by simp [rowGroups])
  have feTerminalSatisfied :
      Satisfies
        (KSplitNcFeTerminal.rows (feTerminalInput input)) assignment :=
    satisfies_group input assignment satisfied _ (by simp [rowGroups])
  have ncSatisfied :
      Satisfies (KSplitNcNcEndpoint.rows (ncInput input)) assignment :=
    satisfies_group input assignment satisfied _ (by simp [rowGroups])
  have pre :
      KSplitNcTranscriptSemantics.PreAgrees assignment
        (KSplitNcTranscript.replay input.transcript)
        (KSplitNcTranscriptPhases.semanticPre
          constants assignment input.transcript) := by
    simpa only [KSplitNcTranscriptPhases.semanticPre] using
      KSplitNcTranscriptSemantics.decoded_preSumcheck
        constants assignment constantWire input.transcript transcriptValid
  have feInitialLocal :=
    KSplitNcFeInitial.rows_sound profile polynomialInput
      (feInitialInput input) assignment constantWire
      (fun running matrix lane =>
        (feInitial_decoder_eq assignment
          (input.authority.claimedYRing running matrix lane)).trans
            (authority.claimedYRing running matrix lane))
      feInitialSatisfied
  have feInitialGamma :
      KSplitNcFeInitial.decoded assignment
          (feInitialInput input).gamma =
        (KSplitNcTranscriptPhases.semanticPre
          constants assignment input.transcript).challenges.gamma := by
    rw [feInitial_decoder_eq]
    exact coreGamma_eq constants assignment input pre
  have feInitial :
      KSplitNcTranscriptSemantics.decodedColumns
          assignment input.transcript.fe.initial =
        KSplitNcTranscriptPhases.semanticFeInitial
          profile constants assignment input.transcript := by
    calc
      KSplitNcTranscriptSemantics.decodedColumns
          assignment input.transcript.fe.initial =
          KPointEquality.decoded assignment
            (carried input.transcript.fe.initial) :=
        (decoded_carried assignment input.transcript.fe.initial).symm
      _ =
          KSplitNcFeInitial.decoded assignment
            (carried input.transcript.fe.initial) :=
        (feInitial_decoder_eq assignment
          (carried input.transcript.fe.initial)).symm
      _ =
          Polynomial.Fe.initial profile polynomialInput
            (KSplitNcFeInitial.decodedCoins
              (feInitialInput input) assignment) :=
        feInitialLocal
      _ =
          KSplitNcTranscriptPhases.semanticFeInitial
            profile constants assignment input.transcript := by
        unfold KSplitNcTranscriptPhases.semanticFeInitial
          KSplitNcFeInitial.decodedCoins Polynomial.Fe.initial
        rw [feInitialAlpha_eq_core,
          coreAlpha_eq constants assignment input pre,
          feInitialGamma]
        rfl
  have feReplay :=
    KSplitNcTranscriptPhases.decoded_fe
      profile constants assignment constantWire input.transcript
      transcriptValid feInitial
  have ncReplay :=
    KSplitNcTranscriptPhases.decoded_nc
      profile constants assignment constantWire input.transcript
      transcriptValid feInitial
  have feTerminalLocal :=
    KSplitNcFeTerminal.rows_sound profile
      (feTerminalInput input) assignment constantWire feTerminalSatisfied
  have feYRing :
      (KSplitNcFeTerminal.decodedMessage
        (feTerminalInput input) assignment).yRing = message.yRing := by
    funext source matrix lane
    exact authority.outputYRing source matrix lane
  have feTerminal :
      KSplitNcTranscriptSemantics.decodedColumns
          assignment input.transcript.fe.terminal =
        Polynomial.Fe.terminalFromMessage profile polynomialInput
          (KSplitNcTranscriptPhases.semanticPre
            constants assignment input.transcript).challenges.feCoins
          (KSplitNcTranscriptPhases.semanticFeExecution
            profile constants assignment input.transcript).challengePoint
          message := by
    calc
      KSplitNcTranscriptSemantics.decodedColumns
          assignment input.transcript.fe.terminal =
          KSplitNcFeTerminal.decoded assignment
            (feTerminalInput input).terminal := by
        change
          KSplitNcTranscriptSemantics.decodedColumns
              assignment input.transcript.fe.terminal =
            KPointEquality.decoded assignment
              (carried input.transcript.fe.terminal)
        exact (decoded_carried
          assignment input.transcript.fe.terminal).symm
      _ =
          Polynomial.Fe.terminalFromMessage profile
            (KSplitNcFeTerminal.decodedPublicInput
              (feTerminalInput input) assignment)
            (KSplitNcFeTerminal.decodedCoins
              (feTerminalInput input) assignment)
            (KSplitNcFeTerminal.decodedPoint
              (feTerminalInput input) assignment)
            (KSplitNcFeTerminal.decodedMessage
              (feTerminalInput input) assignment) :=
        feTerminalLocal
      _ =
          Polynomial.Fe.terminalFromMessage profile polynomialInput
            (KSplitNcTranscriptPhases.semanticPre
              constants assignment input.transcript).challenges.feCoins
            (KSplitNcTranscriptPhases.decodedFePoint
              assignment input.transcript)
            (KSplitNcFeTerminal.decodedMessage
              (feTerminalInput input) assignment) := by
        rw [feTerminal_publicInput_eq input assignment authority,
          feTerminal_coins_eq constants assignment input pre,
          feTerminal_point_eq input assignment]
      _ =
          Polynomial.Fe.terminalFromMessage profile polynomialInput
            (KSplitNcTranscriptPhases.semanticPre
              constants assignment input.transcript).challenges.feCoins
            (KSplitNcTranscriptPhases.decodedFePoint
              assignment input.transcript) message := by
        unfold Polynomial.Fe.terminalFromMessage
        rw [feYRing]
      _ = _ := by rw [feReplay.point]
  have ncLocal :=
    KSplitNcNcEndpoint.rows_sound
      (ncInput input) assignment constantWire ncSatisfied
  have ncMessageYZcol :
      ∀ source lane,
        (KSplitNcNcEndpoint.decodedMessage
            (ncInput input) assignment).yZcol source lane =
          message.yZcol source lane := by
    intro source lane
    exact authority.outputYZcol source lane
  have ncTerminal :
      KSplitNcTranscriptSemantics.decodedColumns
          assignment input.transcript.nc.terminal =
        Polynomial.Nc.BlockLane.Terminal.terminalFromMessage message
          (KSplitNcTranscriptPhases.semanticPre
            constants assignment input.transcript).challenges.ncCoins
          (KSplitNcTranscriptPhases.semanticNcExecution
            profile constants assignment input.transcript).challengePoint := by
    calc
      KSplitNcTranscriptSemantics.decodedColumns
          assignment input.transcript.nc.terminal =
          KSplitNcNcEndpoint.decoded assignment
            (ncInput input).terminal := by
        change
          KSplitNcTranscriptSemantics.decodedColumns
              assignment input.transcript.nc.terminal =
            KPointEquality.decoded assignment
              (carried input.transcript.nc.terminal)
        exact (decoded_carried
          assignment input.transcript.nc.terminal).symm
      _ =
          Polynomial.Nc.BlockLane.Terminal.terminalFromMessage
            (KSplitNcNcEndpoint.decodedMessage
              (ncInput input) assignment)
            (KSplitNcNcEndpoint.decodedCoins
              (ncInput input) assignment)
            (KSplitNcNcEndpoint.decodedPoint
              (ncInput input) assignment) :=
        ncLocal.2
      _ =
          Polynomial.Nc.BlockLane.Terminal.terminalFromMessage
            (KSplitNcNcEndpoint.decodedMessage
              (ncInput input) assignment)
            (KSplitNcTranscriptPhases.semanticPre
              constants assignment input.transcript).challenges.ncCoins
            (KSplitNcTranscriptPhases.decodedNcPoint
              assignment input.transcript) := by
        rw [ncCoins_eq constants assignment input pre,
          ncPoint_eq input assignment]
      _ =
          Polynomial.Nc.BlockLane.Terminal.terminalFromMessage message
            (KSplitNcTranscriptPhases.semanticPre
              constants assignment input.transcript).challenges.ncCoins
            (KSplitNcTranscriptPhases.decodedNcPoint
              assignment input.transcript) :=
        ncTerminal_eq_of_yZcol _ _ ncMessageYZcol _ _
      _ = _ := by rw [ncReplay.point]
  exact {
    feInitial := feInitial
    feTerminal := feTerminal
    ncInitial := by
      calc
        KSplitNcTranscriptSemantics.decodedColumns
            assignment input.transcript.nc.initial =
            KSplitNcNcEndpoint.decoded assignment
              (ncInput input).initial := by
          change
            KSplitNcTranscriptSemantics.decodedColumns
                assignment input.transcript.nc.initial =
              KPointEquality.decoded assignment
                (carried input.transcript.nc.initial)
          exact (decoded_carried
            assignment input.transcript.nc.initial).symm
        _ = Polynomial.Nc.BlockLane.InitialSum.claimedInitial := ncLocal.1
    ncTerminal := ncTerminal
  }

end Nightstream.Implementation.R1CS.Canonical.KSplitNcEndpoints
