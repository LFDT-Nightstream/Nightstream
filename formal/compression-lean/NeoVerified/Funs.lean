def layout.entry_column
  (shape : layout.Shape) (kind : circuit.Kind) (b : Std.Usize)
  (cell : Option Std.Usize) :
  Result Std.Usize
  := do
  match cell with
  | none => layout.one shape
  | some cell1 => layout.block_cell shape kind b cell1

