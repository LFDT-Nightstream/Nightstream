        (FPrimeFullHistoryTerminalAccumulatorCheckCoverage.shiftedLocalRowStart map)).take 124 =
      ShiftedTernaryCompiler.canonicalRows.map
        (Relabel.row
          (FPrimeFullHistoryTerminalAccumulatorCheckCoverage.columnMap map)) := by
  have cases : index = 80 ∨ index = 81 ∨ index = 82 ∨ index = 83 ∨ index = 84 ∨ index = 85 ∨ index = 86 ∨ index = 87 ∨ index = 88 ∨ index = 89 ∨ index = 90 ∨ index = 91 ∨ index = 92 ∨ index = 93 ∨ index = 94 ∨ index = 95 := by omega
