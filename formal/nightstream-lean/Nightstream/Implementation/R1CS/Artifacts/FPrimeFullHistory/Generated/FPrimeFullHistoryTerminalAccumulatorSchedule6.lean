theorem shard6_rows_schedule
    (index : Nat) (lower : 96 ≤ index) (upper : index < 112) :
    let map := FPrimeFullHistoryTerminalAccumulator.shiftedTernaryMaps.getD index default
    ((FPrimeFullHistoryTerminalAccumulatorCheckCoverage.shiftedOwnerRows map).drop
        (FPrimeFullHistoryTerminalAccumulatorCheckCoverage.shiftedLocalRowStart map)).take 124 =
      ShiftedTernaryCompiler.canonicalRows.map
        (Relabel.row
          (FPrimeFullHistoryTerminalAccumulatorCheckCoverage.columnMap map)) := by
  have cases : index = 96 ∨ index = 97 ∨ index = 98 ∨ index = 99 ∨ index = 100 ∨ index = 101 ∨ index = 102 ∨ index = 103 ∨ index = 104 ∨ index = 105 ∨ index = 106 ∨ index = 107 ∨ index = 108 ∨ index = 109 ∨ index = 110 ∨ index = 111 := by omega
  rcases cases with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · simpa [map96,
      FPrimeFullHistoryTerminalAccumulatorCheckCoverage.shiftedOwnerRows,
      FPrimeFullHistoryTerminalAccumulatorCheckCoverage.shiftedLocalRowStart] using
        map96_rows_schedule
