        (FPrimeFullHistoryTerminalAccumulatorCheckCoverage.shiftedLocalRowStart map)).take 124 =
      ShiftedTernaryCompiler.canonicalRows.map
        (Relabel.row
          (FPrimeFullHistoryTerminalAccumulatorCheckCoverage.columnMap map)) := by
  have cases : index = 160 ∨ index = 161 ∨ index = 162 ∨ index = 163 ∨ index = 164 ∨ index = 165 ∨ index = 166 ∨ index = 167 ∨ index = 168 ∨ index = 169 ∨ index = 170 ∨ index = 171 ∨ index = 172 ∨ index = 173 ∨ index = 174 ∨ index = 175 := by omega
